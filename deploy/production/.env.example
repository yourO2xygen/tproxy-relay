# Скопируйте в .env рядом с docker-compose.prod.yml и заполните.
# Быстрее — deploy/production/setup.sh proxy.yourdomain.tld: заполнит сам.

# Сабдомен, по которому клиент подключается к прокси (и из него выводится capability)
TPROXY_PUBLIC_HOSTNAME=proxy.yourdomain.tld

# 32 hex-символа: openssl rand -hex 16
TPROXY_SECRET_HEX=changeme

# Несущая: https (по умолчанию) или websocket
TPROXY_CARRIER_MODE=https

# NAT для MTProxy: локальный IP контейнера в сети tproxy-net / публичный IP сервера.
# Локальный зафиксирован в compose (172.20.0.2), публичный подставьте свой.
MTPROXY_PUBLIC_IP=1.2.3.4
