# Copy to .env next to docker-compose.prod.yml and fill in.
TPROXY_PUBLIC_HOSTNAME=proxy.yourdomain.tld
# openssl rand -hex 16
TPROXY_SECRET_HEX=changeme
# https (default) or websocket
TPROXY_CARRIER_MODE=https
# Only if the server is behind NAT (see README): --nat-info <container-ip>:<public-ip>
MTPROXY_NAT_ARGS=
