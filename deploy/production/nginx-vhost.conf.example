# tproxy vhost для хостового nginx (Debian/Ubuntu layout).
# Замените proxy.yourdomain.tld на ваш домен.
#
# ЭТАП 1 (до получения сертификата): файл уже готов — только блок :80.
#   sudo cp .../nginx-vhost.conf.example /etc/nginx/sites-available/tproxy.conf
#   sudo ln -s /etc/nginx/sites-available/tproxy.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot certonly --webroot -w /var/www/certbot -d proxy.yourdomain.tld
#
# ЭТАП 2: раскомментируйте блок :443 ниже и снова
#   sudo nginx -t && sudo systemctl reload nginx

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Грубая защита от исчерпания сокетов релея одним адресом.
# 32 соединений на IP хватает нескольким устройствам за одним NAT.
limit_conn_zone $binary_remote_addr zone=tproxy_conn:10m;

server {
    listen 80;
    server_name proxy.yourdomain.tld;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

