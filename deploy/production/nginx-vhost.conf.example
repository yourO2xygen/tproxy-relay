# /etc/nginx/sites-available/tproxy.conf  (host-level nginx)
# Replace proxy.yourdomain.tld with the real hostname.
#
# Certbot (webroot renewal):
#   certbot certonly --webroot -w /var/www/certbot -d proxy.yourdomain.tld

server {
    listen 80;
    server_name proxy.yourdomain.tld;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name proxy.yourdomain.tld;

    ssl_certificate     /etc/letsencrypt/live/proxy.yourdomain.tld/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proxy.yourdomain.tld/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The bridge URL and carrier bearer must never be logged.
    access_log off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Every path goes to the relay: no separate probeable transport surface.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        client_max_body_size 4m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
