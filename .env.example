# ─── tproxy-relay: справочник переменных окружения ───────────────────────────
# Слои конфигурации (приоритет сверху вниз):
#   1. env (этот файл / docker compose)
#   2. config.json (см. deploy/config.example.json)
#   3. встроенные дефолты
# Секрет НИКОГДА не читается из config.json — только env или файл.

# ── Обязательное ─────────────────────────────────────────────────────────────
# Секрет MTProxy (hex, 16 байт = 32 hex-символа): openssl rand -hex 16
TPROXY_SECRET_HEX=
# …или путь к файлу с секретом (альтернатива, напр. docker secret)
#TPROXY_SECRET_HEX_FILE=/run/secrets/tproxy_secret

# ── Идентификация и размещение ───────────────────────────────────────────────
# Публичное имя хоста (участвует в выводе capability и проверке Host)
TPROXY_PUBLIC_HOSTNAME=proxy.example.com
# Пусто = прокси в корне; иначе слаг/путь (см. docs/BASE_PATH.md).
# ВНИМАНИЕ: включение/смена = смена кредов всех клиентов.
TPROXY_BASE_PATH=
# Режим несущей: https | websocket | https-lanes | websocket-lanes
TPROXY_CARRIER_MODE=https
# Публичный сайт-прикрытие (взаимоисключающие; см. docs/PUBLIC_SITE.md)
#TPROXY_PUBLIC_DIR=/srv/site
#TPROXY_PUBLIC_UPSTREAM=http://site:8080
# exact | legacy (алиасы без расширений)
#TPROXY_STATIC_ROUTES=exact

# ── Слушатели ────────────────────────────────────────────────────────────────
# Формат: host:port или просто port. SEC-001: админ по умолчанию 127.0.0.1.
TPROXY_LISTEN=0.0.0.0:8080
TPROXY_ADMIN_LISTEN=127.0.0.1:8081
#TPROXY_LISTEN_PORT=8080
#TPROXY_ADMIN_PORT=8081
# Проверка Host-заголовка (true = публичное имя обязательно)
TPROXY_REQUIRE_HOST=true

# ── Файлы состояния ──────────────────────────────────────────────────────────
TPROXY_TOKEN_KEY_PATH=/data/token.key
TPROXY_KEYS_DB=/data/keys.db
# Путь к config.json (по умолчанию ./config.json; несуществующий — ок)
#TPROXY_CONFIG=/data/config.json

# ── Лимиты ёмкости ───────────────────────────────────────────────────────────
TPROXY_MAX_SESSIONS=128
TPROXY_MAX_STREAMS=4096
TPROXY_MAX_STREAMS_PER_SESSION=128
TPROXY_MAX_DIALS_IN_FLIGHT=256
TPROXY_MAX_BOOTSTRAPS=512
# Pending-бюджеты (PERF-002: ≤ ~25% mem_limit контейнера)
TPROXY_MAX_PENDING_GLOBAL_BYTES=268435456
TPROXY_MAX_PENDING_GLOBAL_ITEMS=262144
TPROXY_MAX_PENDING_PER_SESSION_BYTES=16777216
# Кадры и пачки
TPROXY_MAX_FRAME_PAYLOAD=1048576
TPROXY_CARRIER_BATCH_BYTES=2097152

# ── Rate limits (в минуту + burst) ───────────────────────────────────────────
TPROXY_NEW_SESSIONS_PER_MINUTE=600
TPROXY_NEW_SESSIONS_BURST=128
TPROXY_NEW_STREAMS_PER_MINUTE=6000
TPROXY_NEW_STREAMS_BURST=512
TPROXY_NEW_BOOTSTRAPS_PER_MINUTE=1200
TPROXY_NEW_BOOTSTRAPS_BURST=256
# Per-IP лимиты (0 = выключено)
TPROXY_MAX_SESSIONS_PER_IP=0
TPROXY_MAX_BOOTSTRAPS_PER_IP=0

# ── Тайминги (секунды) ───────────────────────────────────────────────────────
TPROXY_LONG_POLL_SECONDS=25
TPROXY_BOOTSTRAP_TTL_SECONDS=120
# Grace до закрытия idle-сессии реапером
TPROXY_RECONNECT_GRACE=120

# ── Управление: Admin API (см. README, раздел Admin API) ─────────────────────
# Fail-closed: enabled без токена = отказ старта. Слушается только админ-порт.
TPROXY_API_ENABLED=false
TPROXY_API_TOKEN=

# ── Управление: Telegram-бот ─────────────────────────────────────────────────
# Fail-closed: enabled без токена = отказ старта.
TPROXY_BOT_ENABLED=false
TPROXY_BOT_TOKEN=
# Список chat-id через запятую. Bootstrap: напишите боту и найдите в логах
# event=tg_stranger chat=<id> — этот id и подставьте.
TPROXY_BOT_ADMINS=

# ── Только для docker-compose (межсервисное) ─────────────────────────────────
# Адрес MTProxy изнутри сети compose
TPROXY_BACKEND_HOST=mtproxy:2398
# MTProxy: секрет builtin-профиль (тот же, что TPROXY_SECRET_HEX) и NAT
MTPROXY_SECRET=
MTPROXY_PUBLIC_IP=
#MTPROXY_NAT_ARGS=--nat-info 172.20.0.2:1.2.3.4

# ── .NET runtime ─────────────────────────────────────────────────────────────
# PERF-002: heap-лимит ниже mem_limit, чтобы GC поджимал раньше OOM-kill
DOTNET_GCHeapHardLimitPercent=75
